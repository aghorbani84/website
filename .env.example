# ============================================================
# 369 Store — Environment Configuration Template
# Copy to .env and fill with real values. NEVER commit .env.
# ============================================================

# --- Runtime ---
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=https://abolfazlghorbani369.ir

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store369

# --- Sessions / Security ---
# Generate a long random secret: bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_COOKIE_NAME=store369_session
SESSION_TTL_HOURS=12

# --- Admin bootstrap ---
# Used by `bun run db:seed` to create the FIRST admin account.
# Change these before seeding in production, or use the create-admin script.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Payment Provider ---
# Leave PAYMENT_PROVIDER unset (or "disabled") until legitimate merchant
# credentials are obtained from an authorized Iranian payment gateway.
# Real checkout stays DISABLED until configured.
PAYMENT_PROVIDER=disabled
# Example for a future provider (fill only with REAL credentials):
# PAYMENT_MERCHANT_ID=
# PAYMENT_TERMINAL_ID=
# PAYMENT_CALLBACK_URL=https://abolfazlghorbani369.ir/api/payments/callback

# --- Currency ---
# Base currency stored in DB is integer RIAL. Display currency: toman | rial
DISPLAY_CURRENCY=toman
