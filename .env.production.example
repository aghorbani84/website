# ============================================================
# 369 Store — Production Build Notes (DEMO BUILD)
# ------------------------------------------------------------
# This build is configured for DEMONSTRATION ONLY:
#   - No real payment provider is connected (PAYMENT_PROVIDER=disabled).
#   - Checkout of demo products is disabled server-side.
#   - All catalog content is clearly marked as demonstration data.
# See docs/LAUNCH_CHECKLIST.md before going live with real products.
# ============================================================

# --- Runtime ---
NODE_ENV=production
API_PORT=3001
WEB_ORIGIN=https://abolfazlghorbani369.ir
PUBLIC_SITE_URL=https://abolfazlghorbani369.ir

# --- Database (PostgreSQL) — REQUIRED for production ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/store369?ssl-mode=require

# --- Sessions / Security ---
SESSION_SECRET=REPLACE-WITH-LONG-RANDOM-SECRET
SESSION_COOKIE_NAME=store369_session
SESSION_TTL_HOURS=12

# --- Admin bootstrap ---
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Payment Provider ---
# Must remain "disabled" until REAL merchant credentials from an
# authorized Iranian payment gateway (shaparak-approved PSP) are obtained.
PAYMENT_PROVIDER=disabled
PAYMENT_MERCHANT_ID=
PAYMENT_TERMINAL_ID=
PAYMENT_CALLBACK_URL=https://abolfazlghorbani369.ir/api/payments/callback

# --- Currency ---
DISPLAY_CURRENCY=toman
